# =============================================================
# Environment Variables untuk Web Sekolah White-Label
# =============================================================
# Copy file ini menjadi .env dan isi dengan value yang benar
# JANGAN commit file .env ke Git!
# =============================================================

# Supabase Configuration (Primary - Singapore Region ap-southeast-1)
# Dapatkan dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Neon Database Configuration (Legacy / Fallback)
# VITE_DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@ep-XXXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Google Analytics (Opsional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
